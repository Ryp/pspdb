{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Derived file inventory keyed by source SHA-256",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "sha256",
    "size_bytes",
    "extractor",
    "entries"
  ],
  "properties": {
    "kind": {
      "const": "tree"
    },
    "schema_version": {
      "const": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "options"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "string"
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "name_rule": {
      "type": "string",
      "enum": [
        "source_stem",
        "strip_suffix"
      ],
      "description": "For a single generated child, derive its occurrence name from the parent while keeping a stable inventory path."
    }
  },
  "$defs": {
    "entry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "type"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "type": {
              "const": "directory"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "type",
            "size_bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "type": {
              "const": "file"
            },
            "size_bytes": {
              "$ref": "#/$defs/size"
            },
            "sha256": {
              "$ref": "#/$defs/hash"
            }
          }
        }
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\:\\u0000-\\u001f]+$",
      "not": {
        "pattern": "//|/$"
      }
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
