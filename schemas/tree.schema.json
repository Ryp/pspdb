{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Derived file inventory keyed by source SHA-256",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "sha256",
    "size_bytes",
    "extractor",
    "entries"
  ],
  "properties": {
    "kind": {
      "const": "tree"
    },
    "schema_version": {
      "const": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "options"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "string",
          "description": "Extractor revision; the parent directory is v followed by this revision in a versioned catalog."
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "name_rule": {
      "type": "string",
      "enum": [
        "source_stem",
        "strip_suffix",
        "decoded_suffix", "identity"
      ],
      "description": "For a single generated child, derive its occurrence name from the parent while keeping a stable inventory path. decoded_suffix removes compression and preserves the detected output format suffix; unknown binary data retains the uncompressed source name."
    }
  },
  "$defs": {
    "entry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "type"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "type": {
              "const": "directory"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "type",
            "size_bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "type": {
              "const": "file"
            },
            "size_bytes": {
              "$ref": "#/$defs/size"
            },
            "sha256": {
              "$ref": "#/$defs/hash"
            },
            "extraction": {
              "$ref": "#/$defs/inlineExtraction"
            }
          }
        }
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\:\\u0000-\\u001f]+$",
      "not": {
        "pattern": "//|/$"
      }
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Exact file dependencies in the same immediate parent inventory as the attached source entry. Paths must be unique and cannot reference the source itself; bindings are checked against that inventory.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          },
          "size_bytes": {
            "$ref": "#/$defs/size"
          }
        }
      }
    },
    "inlineExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size_bytes",
        "extractor",
        "entries",
        "name_rule"
      ],
      "properties": {
        "dependencies": {
          "$ref": "#/$defs/dependencies"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "extractor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "options"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "version": {
              "type": "string",
              "description": "Extractor revision; the parent directory is v followed by this revision in a versioned catalog."
            }
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "name_rule": {
          "type": "string",
          "enum": [
            "source_stem",
            "strip_suffix",
            "decoded_suffix", "identity"
          ],
          "description": "For a single generated child, derive its occurrence name from the parent while keeping a stable inventory path."
        }
      }
    }
  }
}
