+/// Validated PBP sections borrowing the caller's input. No allocation or I/O.
+pub const Pbp = struct {
+    header: PBPHeader,
+    sections: [8][]const u8,
+
+    pub fn parse(bytes: []const u8) !Pbp {
+        var reader = std.Io.Reader.fixed(bytes);
+        const header = try reader.takeStruct(PBPHeader, .little);
+        try validate_header(header);
+        var result: Pbp = .{ .header = header, .sections = undefined };
+        for (header.offset, 0..) |offset, i| {
+            const end: usize = if (i + 1 < header.offset.len) header.offset[i + 1] else bytes.len;
+            if (offset < @sizeOf(PBPHeader) or offset > end or end > bytes.len) return error.InvalidOffset;
+            result.sections[i] = bytes[offset..end];
+        }
+        return result;
+    }
+
+    pub fn walk(self: Pbp, context: anytype, comptime emit: anytype) !void {
+        for (default_file_names, self.sections) |name, bytes| {
+            if (bytes.len != 0) try emit(context, name, bytes);
+        }
+    }
+
+    pub fn get(self: Pbp, name: []const u8) ?[]const u8 {
+        for (default_file_names, self.sections) |entry, bytes| {
+            if (std.mem.eql(u8, entry, name)) return bytes;
+        }
+        return null;
+    }
+};
