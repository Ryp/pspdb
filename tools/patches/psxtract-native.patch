+		printf("ERROR: Invalid STARTDAT span!\n");
+		return -1;
+	}
+	unsigned char *startdat_data = new (std::nothrow) unsigned char[(size_t)startdat_size];
+	if (!startdat_data)
+		return -1;
+	if (fread(startdat_data, 1, (size_t)startdat_size, psar) != startdat_size)
+	{
 		delete[] startdat_data;
-
-		printf("Saving STARTDAT as STARTDAT.BIN...\n\n");
-	}
-
+		return -1;
+	}
+
+	FILE* startdat = fopen("STARTDAT.BIN", "wb");
