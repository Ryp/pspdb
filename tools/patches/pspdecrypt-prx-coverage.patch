+// Bounded, deliberately unauthenticated payload-only operation for PRX type 9.
+// Its external signature is not a KIRK CMAC/ECDSA header; callers must check
+// the PRX header SHA first. Do not use this instead of kirk_CMD1 elsewhere.
+int kirk_CMD1_prx9(u8* outbuff, const u8* inbuff, int size)
+{
+  const KIRK_CMD1_HEADER* header = (const KIRK_CMD1_HEADER*)inbuff;
+  u8 key[16];
+  AES_ctx aes;
+  int bounds = kirk_cmd1_size(header, size);
+  if (bounds != KIRK_OPERATION_SUCCESS) return bounds;
+  if (is_kirk_initialized == 0) return KIRK_NOT_INITIALIZED;
+  if (header->mode != KIRK_MODE_CMD1) return KIRK_INVALID_MODE;
+  AES_cbc_decrypt(&aes_kirk1, inbuff, key, sizeof(key));
+  AES_set_key(&aes, key, 128);
+  AES_cbc_decrypt(&aes, inbuff+sizeof(*header)+header->data_offset, outbuff, header->data_size);
+  return KIRK_OPERATION_SUCCESS;
+}
