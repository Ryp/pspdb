--- /dev/null
+++ b/npumdimg_main.c
@@ -0,0 +1,17 @@
+// Standalone entry point for pkg2zip's existing NPUMDIMG decoder.
+#include "pkg2zip_psp.h"
+#include "pkg2zip_out.h"
+int main(int argc, char** argv)
+{
+    if (argc != 3) sys_error("Usage: pkg2zip-npumdimg SOURCE OUTPUT.iso\n");
+    uint64_t size;
+    sys_output_init();
+    sys_file input = sys_open(argv[1], &size);
+    sys_output_progress_init(size);
+    out_begin(NULL, 0);
+    unpack_psp_eboot(argv[2], NULL, NULL, input, 0, 0, size, 0);
+    out_end();
+    sys_close(input);
+    sys_output_done();
+    return 0;
+}
