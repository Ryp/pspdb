+    descriptor_size = enc_chunks * 8
+    descriptors = des_decrypt(slice_buf(encrypted, 0x20, descriptor_size))
+    payload = bytearray(encrypted[0x20 + descriptor_size:])
+    payload_view = memoryview(payload)
+    # Descriptors can overlap: decrypt each against the current payload, in order.
+    for index in range(enc_chunks):
+        descriptor_offset = index * 8
+        chunk_offset = b2i(slice_buf(descriptors, descriptor_offset, 4))
+        chunk_size = b2i(slice_buf(descriptors, descriptor_offset + 4, 4))
+        chunk = slice_buf(payload_view, chunk_offset, chunk_size)
+        payload_view[chunk_offset:chunk_offset + chunk_size] = des_decrypt(chunk)
