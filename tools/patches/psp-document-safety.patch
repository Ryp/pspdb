+    page_header = des_decrypt(slice_buf(encrypted, 0, 0x20))
+    page_size = b2i(slice_buf(page_header, 0, 4))
+    enc_chunks = b2i(slice_buf(page_header, 8, 4))
+    if enc_chunks > 4096:
+        raise ValueError('Document encryption descriptor budget exceeded')
+    if page_size != info.size:
+        raise ValueError(f'Page {ordinal}: size mismatch')
