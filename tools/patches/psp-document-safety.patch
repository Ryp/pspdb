+        authenticate(encrypted_header, header_mac, header_hash, install_id, 'DOC header')
+        header = des_decrypt(encrypted_header)
+        if slice_buf(header, 0, 4) != b'DOC ':
+            raise ValueError('Invalid DOC header magic')
+        if slice_buf(header, 4, 8) != b'\0\0\1\0\0\0\1\0':
+            raise ValueError('Invalid DOC version')
