+    if marker_offset == -1:
+        raise ValueError(f'Page {ordinal}: PNG trailer not found')
+    png_size = marker_offset + len(marker)
+    if png_size < 0x43:
+        raise ValueError(f'Page {ordinal}: PNG too small or trailer found too early')
