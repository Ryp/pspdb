+// PSPDB: checked entry point. Returns the decoded length or -1; never reads
+// beyond in_size nor writes beyond out_size.
+int pspdb_lz_decompress(unsigned char *out, unsigned int out_size, unsigned char *in, unsigned int in_size)
+{
+	if (in_size < 5)
+		return -1;
+	lz_in_end = in + in_size;
+	lz_overrun = 0;
+	int result = decompress(out, in, out_size);
+	return lz_overrun ? -1 : result;
