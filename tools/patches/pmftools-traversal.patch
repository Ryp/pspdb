--- /dev/null
+++ b/psmfdump/format/PsmfTraversal.cs
@@ -0,0 +1,114 @@
+using System;
+using System.Buffers.Binary;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using System.Text.Json;
+
+namespace VGMToolbox.format
+{
+    // Research instrumentation for the pinned upstream traversal, not a decoder.
+    public sealed class PsmfTraversal
+    {
+        public long DataStart { get; }
+        public long DataEnd { get; }
+        private long consumed;
+        private readonly HashSet<string> declared = new HashSet<string>();
+        private readonly HashSet<string> observed = new HashSet<string>();
+        private readonly List<object> packets = new List<object>();
+        private string stream;
+        private long? payloadStart, payloadEnd;
+
+        public PsmfTraversal(FileStream input)
+        {
+            Span<byte> header = stackalloc byte[130];
+            input.ReadExactly(header);
+            if (!header.Slice(0, 4).SequenceEqual("PSMF"u8)) throw new FormatException("Not PSMF");
+            DataStart = BinaryPrimitives.ReadUInt32BigEndian(header.Slice(8, 4));
+            DataEnd = DataStart + BinaryPrimitives.ReadUInt32BigEndian(header.Slice(12, 4));
+            int count = BinaryPrimitives.ReadUInt16BigEndian(header.Slice(128, 2));
+            if (count == 0 || DataStart < 130L + count * 16L || DataEnd <= DataStart || DataEnd != input.Length)
+                throw new FormatException("Invalid declared PSMF bounds or stream count");
+            Span<byte> entry = stackalloc byte[16];
+            for (int i = 0; i < count; i++)
+            {
+                input.ReadExactly(entry);
+                byte sid = entry[0], channel = entry[1];
+                if (!((sid >= 0xe0 && sid <= 0xef && channel == 0) || (sid == 0xbd && channel < 0x20)))
+                    throw new NotSupportedException($"Unsupported declared stream {sid:x2}:{channel:x2}");
+                if (!declared.Add(Key(sid, channel))) throw new FormatException("Duplicate declared stream");
+            }
+            consumed = DataStart;
+        }
+
+        private static string Key(byte sid, byte channel) => $"{sid:x2}:{channel:x2}";
+        public void Bounds(long start, long length)
+        {
+            if (start < DataStart || length < 0 || start > DataEnd || length > DataEnd - start)
+                throw new FormatException("Packet exceeds declared data range");
+        }
+        public void Begin(long start)
+        {
+            if (start != consumed) throw new FormatException("Unaccounted traversal gap");
+            Bounds(start, 4);
+            stream = null; payloadStart = null; payloadEnd = null;
+        }
+        public long PackEnd(FileStream input, long start)
+        {
+            Bounds(start, 14);
+            input.Position = start + 13;
+            int stuffing = input.ReadByte() & 7;
+            Bounds(start, 14 + stuffing);
+            for (int i = 0; i < stuffing; i++)
+                if (input.ReadByte() != 255) throw new FormatException("Invalid pack stuffing");
+            return start + 14 + stuffing;
+        }
+        public void Pes(FileStream input, long start, long length, byte sid)
+        {
+            Bounds(start, length);
+            // Length-delimited structural packets remain explicit opaque ranges.
+            if (sid == 0xbb || sid == 0xbe || sid == 0xbf) return;
+            if (!(sid == 0xbd || (sid >= 0xe0 && sid <= 0xef)))
+                throw new NotSupportedException($"Unsupported packet {sid:x2}");
+            if (length < 9) throw new FormatException("Short PES header");
+            input.Position = start + 6;
+            if ((input.ReadByte() & 0xc0) != 0x80) throw new FormatException("Not MPEG2 PES");
+            input.ReadByte();
+            int headerLength = input.ReadByte();
+            if (9L + headerLength + (sid == 0xbd ? 4 : 0) > length)
+                throw new FormatException("PES header exceeds packet");
+        }
+        public void Payload(long start, long length, byte sid, byte channel)
+        {
+            Bounds(start, length);
+            stream = Key(sid, channel);
+            if (!declared.Contains(stream)) throw new FormatException($"Undeclared stream {stream}");
+            if (length <= 0) throw new FormatException("Empty stream payload");
+            observed.Add(stream); payloadStart = start; payloadEnd = start + length;
+        }
+        public void Record(long start, long end, byte sid)
+        {
+            Bounds(start, end - start);
+            if (start != consumed || end <= start || (payloadStart.HasValue && (payloadStart < start || payloadEnd > end)))
+                throw new FormatException("Invalid packet accounting");
+            packets.Add(new { start, end, packet_id = sid, stream, payload_start = payloadStart, payload_end = payloadEnd });
+            consumed = end;
+        }
+        public void Finish(FileStream input, string directory)
+        {
+            if (consumed != DataEnd || !observed.SetEquals(declared))
+                throw new FormatException("Incomplete declared data or stream inventory");
+            input.Position = 0;
+            string sourceHash = Convert.ToHexString(SHA256.HashData(input)).ToLowerInvariant();
+            var outputs = Directory.GetFiles(directory).OrderBy(p => p).Select(p => {
+                using var f = File.OpenRead(p);
+                return new { path = Path.GetFileName(p), size_bytes = f.Length, sha256 = Convert.ToHexString(SHA256.HashData(f)).ToLowerInvariant() };
+            }).ToArray();
+            File.WriteAllText(Path.Combine(directory, "manifest.json"), JsonSerializer.Serialize(new {
+                source_sha256 = sourceHash, source_size_bytes = input.Length, data_start = DataStart,
+                data_end = DataEnd, consumed_end = consumed, declared_streams = declared.OrderBy(s => s).ToArray(), packets, outputs
+            }, new JsonSerializerOptions { WriteIndented = true }));
+        }
+    }
+}
