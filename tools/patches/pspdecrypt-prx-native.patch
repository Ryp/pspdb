+// Validate the whole CBC block and CMAC span before either reads ciphertext.
+// AES_cbc_decrypt writes full blocks, including a partial final plaintext block.
+static int kirk_cmd1_size(const KIRK_CMD1_HEADER *header, int size)
+{
+  u32 available, rounded;
+  if (size < (int)sizeof(*header)) return KIRK_INVALID_SIZE;
+  if (header->data_size == 0) return KIRK_DATA_SIZE_ZERO;
+  available = (u32)size - sizeof(*header);
+  if (header->data_offset > available) return KIRK_INVALID_SIZE;
+  available -= header->data_offset;
+  if (header->data_size > available) return KIRK_INVALID_SIZE;
+  rounded = (header->data_size + 15u) & ~15u;
+  if (rounded > available) return KIRK_INVALID_SIZE;
+  return KIRK_OPERATION_SUCCESS;
+}
